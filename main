#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>
using namespace std;
bool useLower   = true;
bool useUpper   = true;
bool useDigits  = true;
bool useSymbols = false;
string buildAlphabet() {
    string alphabet = "";
    if (useLower)   alphabet = alphabet + "abcdefghijklmnopqrstuvwxyz";
    if (useUpper)   alphabet = alphabet + "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if (useDigits)  alphabet = alphabet + "0123456789";
    if (useSymbols) alphabet = alphabet + "!@#$%^&*()-_=+";
    return alphabet;
}
string generatePassword(int length) {
    string alphabet = buildAlphabet();
    if (alphabet == "") {
        return "";
    }
    string password = "";
    for (int i = 0; i < length; i++) {
        int index = rand() % alphabet.size();
        password = password + alphabet[index];
    }
    return password;
}
int main() {
    srand(time(0));
    cout << "Длина пароля: ";
    int length;
    cin >> length;
    string pwd = generatePassword(length);
    cout << "Пароль: " << pwd << "\n";
    return 0;
}
